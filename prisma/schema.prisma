// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 平台用户 ====================
model User {
  id           Int      @id @default(autoincrement())
  name         String?
  avatar       String?
  passwordHash String?  @map("password_hash")
  lastLoginAt  BigInt?  @map("last_login_at")
  createdAt    BigInt   @map("created_at")
  updatedAt    BigInt   @map("updated_at")

  identities  UserIdentity[]
  broadcaster Broadcaster?

  @@map("users")
}

model UserIdentity {
  id          Int    @id @default(autoincrement())
  userId      Int    @map("user_id")
  provider    String
  providerUid String @map("provider_uid")
  createdAt   BigInt @map("created_at")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("user_identities")
}

// ==================== 直播采集绑定（身份码可空） ====================
model Broadcaster {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  authCode     String?  @unique @map("auth_code")
  roomId       Int?     @map("room_id")
  uid          BigInt?
  uname        String?
  uface        String?
  openId       String?  @map("open_id")
  roomName     String?  @map("room_name")
  active       Int      @default(1)
  passwordHash String?  @map("password_hash")
  createdAt    BigInt   @map("created_at")
  updatedAt    BigInt   @map("updated_at")
  lastLoginAt  BigInt?  @map("last_login_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  biliSession   BroadcasterBiliSession?
  receivedGifts ReceivedGift[]

  @@index([active])
  @@index([uid])
  @@map("broadcasters")
}

// ==================== 管理员表 ====================
model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String @map("password_hash")
  createdAt    BigInt @map("created_at")

  @@map("admin_users")
}

// ==================== 弹幕表 ====================
model Danmaku {
  id             BigInt   @id
  roomId         Int      @map("room_id")
  openId         String?  @map("open_id")
  uname          String?
  uface          String?
  msg            String?
  msgId          String?  @unique @map("msg_id")
  dmType         Int      @default(0) @map("dm_type")
  emojiImgUrl    String?  @map("emoji_img_url")
  fansMedalLevel Int      @default(0) @map("fans_medal_level")
  fansMedalName  String?  @map("fans_medal_name")
  guardLevel     Int      @default(0) @map("guard_level")
  ts             BigInt?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ts])
  @@index([roomId, ts])
  @@map("danmaku")
}

// ==================== 礼物表 ====================
model Gift {
  id             BigInt   @id
  roomId         Int      @map("room_id")
  openId         String?  @map("open_id")
  uname          String?
  uface          String?
  giftId         Int?     @map("gift_id")
  giftName       String?  @map("gift_name")
  giftNum        Int      @default(1) @map("gift_num")
  giftIcon       String?  @map("gift_icon")
  price          Int      @default(0)
  rPrice         Int      @default(0) @map("r_price")
  paid           Int      @default(0)
  fansMedalLevel Int      @default(0) @map("fans_medal_level")
  fansMedalName  String?  @map("fans_medal_name")
  guardLevel     Int      @default(0) @map("guard_level")
  msgId          String?  @unique @map("msg_id")
  ts             BigInt?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@index([ts])
  @@index([roomId, ts])
  @@map("gift")
}

// ==================== 舰长表 ====================
model Guard {
  id             BigInt   @id
  roomId         Int      @map("room_id")
  openId         String?  @map("open_id")
  uname          String?
  uface          String?
  guardLevel     Int?     @map("guard_level")
  guardNum       Int      @default(1) @map("guard_num")
  guardUnit      String?  @map("guard_unit")
  price          Int      @default(0)
  fansMedalLevel Int      @default(0) @map("fans_medal_level")
  fansMedalName  String?  @map("fans_medal_name")
  msgId          String?  @unique @map("msg_id")
  ts             BigInt?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@index([ts])
  @@index([roomId, ts])
  @@map("guard")
}

// ==================== SuperChat表 ====================
model SuperChat {
  id             BigInt   @id
  roomId         Int      @map("room_id")
  openId         String?  @map("open_id")
  uname          String?
  uface          String?
  messageId      BigInt?  @map("message_id")
  message        String?
  rmb            Int      @default(0)
  startTime      BigInt?  @map("start_time")
  endTime        BigInt?  @map("end_time")
  guardLevel     Int      @default(0) @map("guard_level")
  fansMedalLevel Int      @default(0) @map("fans_medal_level")
  fansMedalName  String?  @map("fans_medal_name")
  msgId          String?  @unique @map("msg_id")
  ts             BigInt?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@index([ts])
  @@index([roomId, ts])
  @@map("super_chat")
}

// ==================== 开播/下播事件表 ====================
model LiveStatus {
  id        BigInt   @id
  roomId    Int      @map("room_id")
  openId    String?  @map("open_id")
  title     String?
  areaName  String?  @map("area_name")
  isStart   Int      @default(1) @map("is_start")
  msgId     String?  @unique @map("msg_id")
  ts        BigInt?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, ts])
  @@map("live_status")
}

// ==================== B站网页登录态（加密 Cookie） ====================
model BroadcasterBiliSession {
  id              Int         @id @default(autoincrement())
  broadcasterId   Int         @unique @map("broadcaster_id")
  cookieEnc       String      @map("cookie_enc")
  cookieUid       BigInt      @map("cookie_uid")
  boundAt         BigInt      @map("bound_at")
  syncStatus      String      @default("idle") @map("sync_status")
  syncError       String?     @map("sync_error")
  syncAt          BigInt?     @map("sync_at")
  syncFrom        String?     @map("sync_from")
  syncTo          String?     @map("sync_to")
  syncCursor      String?     @map("sync_cursor")
  syncRawCount    Int         @default(0) @map("sync_raw_count")
  syncUniqueCount Int         @default(0) @map("sync_unique_count")
  createdAt       BigInt      @map("created_at")
  updatedAt       BigInt      @map("updated_at")
  broadcaster     Broadcaster @relation(fields: [broadcasterId], references: [id], onDelete: Cascade)

  @@map("broadcaster_bili_sessions")
}

// ==================== 创作者中心礼物流水（getReceivedGiftStream） ====================
model ReceivedGift {
  id            BigInt      @id @default(autoincrement())
  broadcasterId Int         @map("broadcaster_id")
  roomId        Int         @map("room_id")
  uid           BigInt
  uname         String?
  time          String
  ts            BigInt?
  goodsId       Int?        @map("goods_id")
  giftId        Int         @map("gift_id")
  name          String
  num           Int         @default(1)
  hamster       Int         @default(0)
  receiveTitle  String?     @map("receive_title")
  uniqueKey     String      @unique @map("unique_key")
  createdAt     DateTime    @default(now()) @map("created_at")
  broadcaster   Broadcaster @relation(fields: [broadcasterId], references: [id], onDelete: Cascade)

  @@index([broadcasterId, ts])
  @@index([broadcasterId, giftId])
  @@map("received_gift")
}
